---
import { funders } from '../data/funders';

interface Props {
  heading?: string;
}
const { heading = 'Our research has been funded by' } = Astro.props;
---

<section class="funders" aria-labelledby="funders-heading">
  <div class="wrap funders-inner">
    <p class="eyebrow" id="funders-heading">{heading}</p>
    <ul>
      {
        funders.map((f) => (
          <li>
            <a href={f.href} rel="noopener" title={f.name}>
              {f.logo ? (
                <img src={f.logo} alt={f.name} loading="lazy" />
              ) : (
                <>
                  <span class="short">{f.short}</span>
                  <span class="name">{f.name}</span>
                </>
              )}
              <span class="note">{f.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .funders {
    background: var(--surface);
    border-block: 1px solid var(--line);
    padding-block: clamp(28px, 4vw, 44px);
  }
  .funders-inner {
    display: grid;
    gap: 18px;
  }
  .funders .eyebrow {
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0;
  }
  li + li {
    border-left: 1px solid var(--line);
  }
  @media (max-width: 899px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li + li {
      border-left: 0;
    }
    li:nth-child(even) {
      border-left: 1px solid var(--line);
    }
    li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  a {
    display: grid;
    gap: 2px;
    align-content: start;
    min-height: 100%;
    padding: 14px clamp(14px, 2.5vw, 28px);
    color: var(--ink);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  a:hover {
    background: var(--teal-soft);
  }
  .short {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .name {
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.3;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 4px;
  }
  img {
    height: 44px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }
  :global(:root[data-theme='dark']) img {
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }
</style>
