---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import filmRatings from '../data/film-ratings.json';

const ratings: Record<string, { rating: number; checked: string }> = filmRatings;
const imdbUrl = (id: string) => `https://www.imdb.com/title/${id}/`;

const GROUP_ORDER = ['Principal Investigator', 'Postdoctoral researchers', 'Research team', 'Research staff', 'PhD students', 'Students', 'Alumni'] as const;

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const rendered = await Promise.all(members.map(async (m) => ({ m, Content: (await render(m)).Content })));
const byGroup = (r: (typeof rendered)[number]) => GROUP_ORDER.indexOf(r.m.data.group);
const current = rendered.filter((r) => r.m.data.group !== 'Alumni').sort((a, b) => byGroup(a) - byGroup(b) || a.m.data.order - b.m.data.order);
const groups = [
  { name: 'Principal Investigator', people: current.filter((r) => r.m.data.group === 'Principal Investigator') },
  { name: 'Current members', people: current.filter((r) => r.m.data.group !== 'Principal Investigator') },
].filter((g) => g.people.length);
const alumni = rendered.filter((r) => r.m.data.group === 'Alumni');

function initials(name: string) {
  return name
    .replace(/^(Dr|Prof)\.?\s+/, '')
    .replace(/\(.*?\)/g, '')
    .split(/\s+/)
    .filter(Boolean)
    .map((p) => p[0])
    .slice(0, 2)
    .join('');
}
---

<Base title="Team" description="Meet The Courtney Group at Queen’s University Belfast: the people studying influenza RNA biology, and their favourite films.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Team</p>
      <h1>The people behind the pipettes</h1>
      <p class="lede">Each of us brings something different to the bench. Hover over or tap a photo to see our favourite film to sit down and watch on a Friday night.</p>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="section">
        <div class="wrap">
          <h2 class="group-title">{g.name}</h2>
          <div class:list={['people', { solo: g.name === 'Principal Investigator' }]}>
            {g.people.map(({ m, Content }) => (
              <article class="person">
                <div class="card">
                  <button class="flip" type="button" aria-label={`Show ${m.data.name}'s favourite film`} aria-pressed="false">
                    <span class="face front">
                      {m.data.photo ? (
                        <img src={m.data.photo} alt={m.data.name} loading="lazy" width="700" height="700" />
                      ) : (
                        <span class="initials">{initials(m.data.name)}</span>
                      )}
                    </span>
                    <span class:list={['face back', { 'has-link': m.data.imdb }]}>
                      <span class="ticket-label">Favourite film</span>
                      <span class="film">{m.data.film ?? 'To be added'}</span>
                      {m.data.filmYear && <span class="year">{m.data.filmYear}</span>}
                      {m.data.imdb && ratings[m.data.imdb] && (
                        <span class="imdb-badge" aria-label={`IMDb rating ${ratings[m.data.imdb].rating} out of 10`}>
                          <span class="imdb-logo">IMDb</span> ★ {ratings[m.data.imdb].rating.toFixed(1)}/10
                        </span>
                      )}
                      <span class="perf" aria-hidden="true" />
                    </span>
                  </button>
                  {m.data.imdb && (
                    <a class="imdb-link" href={imdbUrl(m.data.imdb)} target="_blank" rel="noopener">
                      View on IMDb <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
                <div class="info">
                  <h3>{m.data.name}</h3>
                  <p class="role">{m.data.role}</p>
                  <div class="bio">
                    <Content />
                  </div>
                  <p class="links">
                    {m.data.links.email && <a href={`mailto:${m.data.links.email}`}>Email</a>}
                    {m.data.links.orcid && <a href={m.data.links.orcid}>ORCID</a>}
                    {m.data.links.linkedin && <a href={m.data.links.linkedin}>LinkedIn</a>}
                    {m.data.links.scholar && <a href={m.data.links.scholar}>Google Scholar</a>}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  {
    alumni.length > 0 && (
      <section class="section alumni-band">
        <div class="wrap">
          <h2 class="group-title">Alumni</h2>
          <ul class="alumni">
            {alumni.map(({ m }) => (
              <li>
                <strong>{m.data.name}</strong>
                <span>{m.data.role}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Through the years</p>
        <h2>The lab, then and now</h2>
      </div>
      <div class="timeline">
        <figure>
          <img src="/images/lab1-sm.jpg" alt="The Courtney Group outside the Wellcome-Wolfson Institute for Experimental Medicine" loading="lazy" width="900" height="675" />
          <figcaption><span>Then</span> Outside the Wellcome-Wolfson Institute</figcaption>
        </figure>
        <figure>
          <img src="/images/lab2-sm.jpg" alt="The Courtney Group together on a city street" loading="lazy" width="900" height="506" />
          <figcaption><span>Along the way</span> Out and about in the city</figcaption>
        </figure>
        <figure>
          <img src="/images/lab3-sm.jpg" alt="The Courtney Group on a hike in the mountains" loading="lazy" width="900" height="675" />
          <figcaption><span>Now</span> Out in the hills together</figcaption>
        </figure>
      </div>
      <p class="join-note">Want to be in the next photo? <a href="/join/">See current opportunities</a>.</p>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.flip').forEach((b) =>
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))),
  );
</script>

<style>
  .group-title {
    font-size: var(--step-2);
    margin-bottom: 28px;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 28px;
  }
  .people.solo {
    grid-template-columns: 1fr;
  }
  .person {
    display: grid;
    gap: 16px;
    align-content: start;
    min-width: 0;
  }
  .solo .person {
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: start;
  }
  @media (max-width: 720px) {
    .solo .person {
      grid-template-columns: 1fr;
    }
  }
  .flip {
    all: unset;
    cursor: pointer;
    display: grid;
    aspect-ratio: 1;
    max-width: 100%;
    perspective: 1000px;
    border-radius: 20px;
  }
  .flip:focus-visible {
    outline: 3px solid var(--saffron);
    outline-offset: 3px;
  }
  .face {
    grid-area: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    backface-visibility: hidden;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--teal-soft);
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    color: var(--teal);
  }
  .back {
    transform: rotateY(180deg);
    background: #0f2433;
    color: #f5efe0;
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    gap: 8px;
    padding: 22px;
    position: relative;
    border: 2px dashed #e9a52b;
  }
  .ticket-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e9a52b;
  }
  .film {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 8.5cqi, 2rem);
    font-weight: 700;
    line-height: 1.1;
  }
  .year {
    font-family: var(--font-mono);
    opacity: 0.7;
  }
  .card {
    position: relative;
    display: grid;
    container-type: inline-size;
  }
  .back.has-link {
    padding-bottom: 64px;
  }
  .card:hover .front,
  .flip[aria-pressed='true'] .front {
    transform: rotateY(-180deg);
  }
  .card:hover .back,
  .flip[aria-pressed='true'] .back {
    transform: rotateY(0deg);
  }
  .info {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .role {
    color: var(--teal);
    font-weight: 600;
  }
  .bio {
    color: var(--muted);
    max-width: 68ch;
  }
  .imdb-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    color: #f5efe0;
  }
  .imdb-logo {
    background: #f5c518;
    color: #000;
    font-family: Impact, 'Arial Black', var(--font-display);
    font-weight: 900;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .imdb-link {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease 0.15s;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid #f5c518;
    background: #f5c518;
    color: #000;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  .card:hover .imdb-link,
  .card:has(.flip[aria-pressed='true']) .imdb-link,
  .imdb-link:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .imdb-link:hover {
    background: #ffd84d;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .timeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .timeline figure {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .timeline img {
    border-radius: 18px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    width: 100%;
  }
  .timeline figcaption {
    color: var(--muted);
  }
  .timeline figcaption span {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    margin-right: 8px;
  }
  .alumni-band {
    background: var(--teal-soft);
  }
  .alumni {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px 28px;
  }
  .alumni li {
    display: grid;
    padding-left: 14px;
    border-left: 3px solid var(--teal);
  }
  .alumni span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .join-note {
    margin-top: 24px;
  }
</style>
