---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNews, formatDate, tagSlug } from '../../lib/news';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getNews();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, more: posts.filter((p) => p.id !== post.id).slice(0, 2) } }));
}

const { post, more } = Astro.props;
const { Content } = await render(post);
const { title, date, datePrecision, summary, tags, image, imageAlt } = post.data;
const url = new URL(`/news/${post.id}/`, SITE.url).href;
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const bluesky = `https://bsky.app/intent/compose?text=${encodeURIComponent(`${title} ${url}`)}`;
---

<Base title={title} description={summary} image={image} type="article" published={date}>
  <article>
    <header class="page-hero">
      <div class="wrap">
        <p class="eyebrow"><a class="back" href="/news/">News</a> · <time datetime={date.toISOString()}>{formatDate(date, datePrecision)}</time></p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
        <p class="tags">{tags.map((t) => <a class="tag" href={`/news/tag/${tagSlug(t)}/`}>{t}</a>)}</p>
      </div>
    </header>
    <div class="section">
      <div class="wrap layout">
        <div class="prose body">
          {image && <img class="hero-img" src={image} alt={imageAlt ?? ''} />}
          <Content />
        </div>
        <aside class="share">
          <p class="eyebrow">Share this</p>
          <a class="btn li" href={linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4z"></path></svg>
            Share on LinkedIn
          </a>
          <a class="btn ghost" href={bluesky} target="_blank" rel="noopener">Share on Bluesky</a>
          <button class="btn ghost copy" type="button" data-url={url}>Copy link</button>
        </aside>
      </div>
    </div>
  </article>
  {
    more.length > 0 && (
      <section class="section more">
        <div class="wrap">
          <h2 class="more-title">More news</h2>
          <div class="grid">{more.map((p) => <NewsCard post={p} />)}</div>
        </div>
      </section>
    )
  }
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.url ?? location.href);
        b.textContent = 'Link copied';
      } catch {
        b.textContent = b.dataset.url ?? '';
      }
    }),
  );
</script>

<style>
  .back {
    color: inherit;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .page-hero .tag {
    background: rgb(255 255 255 / 12%);
    color: var(--masthead-ink);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .hero-img {
    width: 100%;
    margin-bottom: 8px;
  }
  .share {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 10px;
  }
  .btn.li {
    background: #0a66c2;
    border-color: #0a66c2;
    color: #fff;
  }
  .copy {
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .more {
    background: var(--teal-soft);
  }
  .more-title {
    font-size: var(--step-2);
    margin-bottom: 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
  }
</style>
