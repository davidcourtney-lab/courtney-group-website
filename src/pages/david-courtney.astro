---
import Base from '../layouts/Base.astro';
import FunderBanner from '../components/FunderBanner.astro';
import { SITE } from '../data/site';
import { publications } from '../data/publications';
import { citationStats, citationsFor, paperLink } from '../data/citations';
import { headline, summary, positions, education, roles, grants, patents, memberships, expertise, mentoring, media, talks } from '../data/cv';

// Papers to feature, matched on the start of the title.
const featured = [
  'Myoferlin is a component',
  'The RBPome of influenza A virus mRNA',
  'Identifying cellular RNA-binding proteins',
  'Epitranscriptomic enhancement of influenza A virus',
  'Epitranscriptomic regulation of HIV-1',
]
  .map((start) => publications.find((p) => p.title.startsWith(start)))
  .filter((p) => p !== undefined);

const author = citationStats.author;
const stats = [
  author && { value: author.citations.toLocaleString('en-GB'), label: 'citations' },
  author?.hIndex && { value: String(author.hIndex), label: 'h-index' },
  { value: '€1.83M', label: 'in personal ERC and Marie Skłodowska-Curie funding' },
  { value: '3', label: 'US patent applications: antivirals, RNA and gene editing' },
].filter(Boolean) as { value: string; label: string }[];

const highlights = [
  'UK Ambassador for the ERC',
  'ERC Starting Grant holder',
  'Marie Skłodowska-Curie Fellow',
  'Innovate UK ICURe Entrepreneurial Lead',
  'BBSRC Panel of Experts',
  'MSCA panel Vice-Chair',
];

const links = [
  { href: SITE.profiles.qub, label: 'Queen’s profile' },
  { href: SITE.profiles.orcid, label: 'ORCID' },
  { href: SITE.profiles.pure, label: 'Queen’s Pure' },
  { href: SITE.profiles.scholar, label: 'Google Scholar' },
  { href: SITE.profiles.linkedin, label: 'LinkedIn' },
].filter((l) => l.href);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${SITE.url}/david-courtney/#page`,
  url: `${SITE.url}/david-courtney/`,
  name: 'Dr David Courtney, molecular virologist at Queen’s University Belfast',
  mainEntity: { '@id': `${SITE.url}/#david-courtney` },
};
---

<Base
  title="Dr David Courtney, molecular virologist"
  description="Dr David Courtney is a Senior Lecturer in Molecular Virology at Queen’s University Belfast, ERC Starting Grant holder and UK Ambassador for the European Research Council. Biography, career, grants, patents and CV."
  image="/images/david.jpg"
  schema={schema}
>
  <section class="page-hero profile-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Principal Investigator</p>
        <h1>Dr David Courtney</h1>
        <p class="lede">{headline}</p>
        <ul class="badges">
          {highlights.map((h) => <li>{h}</li>)}
        </ul>
        <div class="cta">
          <a class="btn primary" href="/david-courtney-cv.pdf" download="David-Courtney-CV.pdf">Download CV (PDF)</a>
          <a class="btn ghost-light" href={`mailto:${SITE.email}`}>Email David</a>
        </div>
      </div>
      <img class="portrait" src="/images/david-square.jpg" alt="Dr David Courtney" width="700" height="700" />
    </div>
  </section>

  <section class="section">
    <div class="wrap about-grid">
      <div class="prose">
        <p class="eyebrow">About</p>
        <h2>Virologist, RNA biologist, advocate for frontier research</h2>
        <p>{summary}</p>
        <p>
          David trained in Biomedical Sciences at Ulster University, including a year in GlaxoSmithKline’s BioPharm R&amp;D
          division, and stayed at Ulster for a PhD developing siRNA and CRISPR medicines for inherited eye disease. He then
          moved into virology as a Marie Skłodowska-Curie Fellow, first at Duke University and then at Institut Pasteur
          in Paris, where he helped show how chemical modifications on viral RNA control how well viruses such as influenza
          and HIV-1 replicate.
        </p>
        <p>
          He returned to Belfast in 2020, worked on antiviral drug repurposing during the COVID-19 pandemic, became a
          regular expert voice on BBC television and radio, and founded
          The Courtney Group in 2021 with a €1.57M ERC Starting Grant. He was promoted to Senior Lecturer in 2025, the
          same year the group’s first PhD students graduated. In April 2025 he was appointed the United Kingdom’s
          Ambassador for the European Research Council, one of 32 researchers making the case for investment in
          frontier science. He sits on the BBSRC Panel of Experts and is Vice-Chair of a Marie Skłodowska-Curie Actions
          fellowship panel. In September 2026 he was selected as an Entrepreneurial Lead on Innovate UK’s
          competitive, UKRI-funded ICURe Discover programme, which helps researchers take discoveries from the lab
          towards real-world use.
        </p>
        <p>
          David is a STEM NI Ambassador and a Fellow of the Winston Churchill Memorial Trust, and regularly hosts school
          pupils and undergraduates in the lab. <a href="/citizenship/">See the lab’s citizenship work</a>.
        </p>
      </div>
      <aside class="side">
        <div class="stats">
          {
            stats.map((s) => (
              <div class="stat">
                <span class="stat-value">{s.value}</span>
                <span class="stat-label">{s.label}</span>
              </div>
            ))
          }
        </div>
        {author && citationStats.updated && <p class="small">Citation figures from OpenAlex, updated {citationStats.updated}.</p>}
        <div class="card">
          <h3>Expertise</h3>
          <ul>{expertise.map((e) => <li>{e}</li>)}</ul>
          <a href="/work-with-us/">Working with industry →</a>
        </div>
        <div class="card">
          <h3>Find David online</h3>
          <ul class="link-list">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Career</p>
        <h2>From GSK to the ERC</h2>
      </div>
      <ol class="timeline">
        {
          [...positions, ...education].map((i) => (
            <li>
              <span class="when">{i.when}</span>
              <div>
                <h3>{i.title}</h3>
                {i.where && <p class="where">{i.where}</p>}
                {i.detail && <p class="detail">{i.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <FunderBanner heading="David’s research has been funded by" />

  <section class="section">
    <div class="wrap columns">
      <div>
        <p class="eyebrow">Recognition</p>
        <h2>Leadership and service</h2>
        <ul class="entries">
          {
            roles.map((i) => (
              <li>
                <span class="when">{i.when}</span>
                <div>
                  <h3>{i.title}</h3>
                  {i.detail && <p class="detail">{i.detail}</p>}
                </div>
              </li>
            ))
          }
        </ul>
        <p class="small">Member of the {memberships.join(', ').replace(/, ([^,]*)$/, ' and $1')}.</p>
      </div>
      <div>
        <p class="eyebrow">Funding</p>
        <h2>Grants and awards</h2>
        <ul class="entries">
          {
            grants.map((i) => (
              <li>
                <span class="when">{i.when}</span>
                <div>
                  <h3>{i.title}</h3>
                  {i.where && <p class="where">{i.where}</p>}
                  {i.detail && <p class="detail">{i.detail}</p>}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap columns">
      <div>
        <p class="eyebrow">Selected papers</p>
        <h2>Key publications</h2>
        <ul class="entries papers">
          {
            featured.map((p) => (
              <li>
                <span class="when">{p.year}</span>
                <div>
                  <h3><a href={paperLink(p)}>{p.title}</a></h3>
                  <p class="where"><em>{p.journal}</em>{citationsFor(p)?.cites ? ` · cited ${citationsFor(p)!.cites} times` : ''}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <p><a class="btn ghost" href="/publications/">All publications</a></p>
      </div>
      <div>
        <p class="eyebrow">Intellectual property</p>
        <h2>Patent applications</h2>
        <ul class="entries">
          {
            patents.map((i) => (
              <li>
                <span class="when">{i.when}</span>
                <div>
                  <h3>{i.title}</h3>
                  {i.where && <p class="where">{i.where}</p>}
                  {i.detail && <p class="detail">{i.detail}</p>}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap columns">
      <div>
        <p class="eyebrow">People</p>
        <h2>Mentoring and leadership</h2>
        <ul class="ticks">{mentoring.map((m) => <li>{m}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">Out and about</p>
        <h2>Talks and media</h2>
        <ul class="ticks">{media.map((m) => <li>{m}</li>)}</ul>
        <ul class="entries">
          {
            talks.map((i) => (
              <li>
                <span class="when">{i.when}</span>
                <div>
                  <h3>{i.title}</h3>
                  {i.where && <p class="where">{i.where}</p>}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section cv-band">
    <div class="wrap cv-grid">
      <div class="prose">
        <p class="eyebrow">Curriculum vitae</p>
        <h2>Need David’s CV?</h2>
        <p>Career history, funding, service, patents and selected publications, kept up to date with this site.</p>
      </div>
      <div class="cta">
        <a class="btn" href="/david-courtney-cv.pdf" download="David-Courtney-CV.pdf">Download CV (PDF)</a>
        <a class="btn ghost" href="/cv/">View in browser</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 320px;
      order: -1;
    }
  }
  .hero-copy {
    display: grid;
    gap: 18px;
  }
  .profile-hero h1 {
    font-size: var(--step-4);
  }
  .portrait {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 6px solid rgb(255 255 255 / 10%);
    box-shadow: 0 30px 60px rgb(0 0 0 / 35%);
  }
  .badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .badges li {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 22%);
    background: rgb(255 255 255 / 6%);
  }
  .badges li:first-child {
    background: #e9a52b;
    border-color: #e9a52b;
    color: #0f2433;
    font-weight: 500;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .btn.primary {
    background: #e9a52b;
    border-color: #e9a52b;
    color: #0f2433;
  }
  .btn.ghost-light {
    background: transparent;
    border-color: rgb(255 255 255 / 40%);
    color: var(--masthead-ink);
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  .side {
    display: grid;
    gap: 18px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stat {
    background: var(--surface);
    padding: 18px;
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .small {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
    display: grid;
    gap: 12px;
  }
  .card ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 4px;
  }
  .card .link-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .alt {
    background: var(--teal-soft);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-left: 2px solid color-mix(in srgb, var(--teal) 45%, transparent);
    margin-left: 6px;
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 18px;
    padding: 0 0 26px 26px;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -8px;
    top: 4px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--teal);
  }
  .timeline li:first-child::before {
    background: var(--saffron);
    border-color: var(--saffron);
  }
  @media (max-width: 640px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
  .when {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--teal);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
    white-space: nowrap;
  }
  .timeline h3,
  .entries h3 {
    font-size: 1.08rem;
    line-height: 1.3;
  }
  .where {
    font-weight: 600;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .detail {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
  .columns > div {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .entries {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .entries li {
    display: grid;
    /* Wide enough for a full range such as "2021 – 2026" in the mono font. */
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 480px) {
    .entries li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
  .ticks {
    margin: 4px 0 0;
    padding-left: 1.1em;
    display: grid;
    gap: 8px;
  }
  .papers h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .papers h3 a:hover {
    color: var(--teal);
    text-decoration: underline;
  }
  .cv-band {
    background: var(--masthead);
    color: var(--masthead-ink);
  }
  .cv-band .eyebrow {
    color: var(--saffron);
  }
  .cv-band .btn {
    background: #e9a52b;
    border-color: #e9a52b;
    color: #0f2433;
  }
  .cv-band .btn.ghost {
    background: transparent;
    border-color: rgb(255 255 255 / 40%);
    color: var(--masthead-ink);
  }
  .cv-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
</style>
